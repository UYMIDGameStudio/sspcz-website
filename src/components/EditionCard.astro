---
/**
 * Component (semantic, stateless): an edition's archival identity plate —
 * edition numeral, session, theme (bilingual) — presented on the ice-blue
 * contextual paper as the cover's current-issue entry (ADR-003 §3.5). The
 * whole plate is a single link into the edition; the numeral carries the
 * ordinal edition mark as its accessible label (as EditionNumeral does), so
 * screen readers hear "Issue III", not "zero three".
 */
import type { Locale } from '../lib/issueData';
import { paddedIssue, issueMark, sessionLabel } from '../lib/format';
import { t } from '../i18n';

interface Props {
  n: number;
  locale: Locale;
  href: string;
  theme: { zh: string; en: string };
  year: number;
  /** Full edition title shown on the entry line, e.g. 第三届浙江中学生哲学大会. */
  title: string;
  /** Localized call to enter the edition, e.g. 查看详情. */
  cta: string;
}

const { n, locale, href, theme, year, title, cta } = Astro.props;
const themePrimary = locale === 'zh' ? theme.zh : theme.en;
const themeSecondary = locale === 'zh' ? theme.en : theme.zh;
const dict = t(locale);
---

<a class="edition-card" href={href}>
  <div class="edition-card__grid">
    <div class="edition-card__index">
      <p class="edition-card__label">{dict.home.currentTitle}</p>
      <p class="edition-card__numeral">
        <span aria-hidden="true">{paddedIssue(n)}</span>
        <span class="edition-card__numeral-label">{issueMark(n, locale)}</span>
      </p>
      <p class="edition-card__session">{sessionLabel(n, locale)} · {year}</p>
    </div>
    <div class="edition-card__theme">
      <p class="edition-card__label">{dict.currentIssue.themeLabel}</p>
      <h2 class="edition-card__theme-primary">{themePrimary}</h2>
      <p class="edition-card__theme-secondary" lang={locale === 'zh' ? 'en' : 'zh-CN'}>{themeSecondary}</p>
      <p class="edition-card__enter">
        <span class="edition-card__enter-title">{title}</span>
        <span class="edition-card__enter-cue">{cta}<span class="edition-card__arrow" aria-hidden="true">↗</span></span>
      </p>
    </div>
  </div>
</a>

<style>
  .edition-card {
    display: block;
    margin-top: var(--space-12);
    background: var(--surface-secondary);
    border: 1px solid var(--surface-secondary);
    color: var(--color-ink);
  }

  .edition-card:hover,
  .edition-card:focus-visible {
    border-color: var(--color-accent-deep);
  }

  .edition-card__grid {
    display: grid;
    grid-template-columns: var(--edition-track) minmax(0, 1fr);
  }

  .edition-card__index {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-12) var(--space-8);
    background: var(--color-ink);
  }

  .edition-card__theme {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    padding: var(--space-10) var(--space-12);
  }

  .edition-card__label {
    font-family: var(--font-sans-cjk);
    font-size: var(--type-marginalia);
    letter-spacing: normal;
    color: var(--color-accent-deep);
    text-transform: uppercase;
  }

  .edition-card__index .edition-card__label {
    color: var(--color-text-on-dark-muted);
  }

  .edition-card__numeral {
    margin-top: 0;
    font-family: var(--font-numeral);
    font-size: var(--text-numeral);
    line-height: var(--leading-none);
    color: var(--surface-secondary);
  }

  .edition-card__numeral-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  .edition-card__session {
    margin-top: 0;
    font-family: var(--font-sans-cjk);
    font-size: var(--type-metadata);
    letter-spacing: normal;
    color: var(--color-text-on-dark);
  }

  :global(html:lang(en)) .edition-card__session {
    font-family: var(--font-serif-latin);
  }

  .edition-card__theme-primary {
    margin-top: var(--space-3);
    font-family: var(--font-serif-cjk);
    font-weight: var(--weight-bold);
    font-size: var(--type-theme);
    line-height: var(--leading-tight);
    letter-spacing: normal;
    color: var(--color-ink);
  }

  :global(html:lang(en)) .edition-card__theme-primary {
    font-family: var(--font-serif-latin);
    letter-spacing: var(--tracking-tight);
  }

  .edition-card__theme-secondary {
    margin-top: var(--space-3);
    font-family: var(--font-serif-latin);
    font-style: italic;
    font-size: var(--text-md);
    color: var(--color-text);
  }

  :global(html:lang(en)) .edition-card__theme-secondary {
    font-family: var(--font-serif-cjk);
    font-style: normal;
  }

  .edition-card__enter {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    align-items: center;
    justify-content: space-between;
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-line-control);
    font-size: var(--type-metadata);
  }

  .edition-card__enter-title {
    font-family: var(--font-sans-cjk);
    color: var(--color-ink);
  }

  :global(html:lang(en)) .edition-card__enter-title {
    font-family: var(--font-serif-latin);
  }

  .edition-card__enter-cue {
    display: inline-flex;
    align-items: center;
    gap: var(--space-4);
    font-weight: var(--weight-semibold);
    color: var(--color-accent-deep);
  }

  .edition-card__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--target-min);
    height: var(--target-min);
    border: 1px solid var(--color-line-control);
    font-family: var(--font-sans-cjk);
    font-size: var(--type-heading-sub);
    transition: color var(--duration-hover) var(--ease-standard),
      background-color var(--duration-hover) var(--ease-standard);
  }

  .edition-card:hover .edition-card__arrow,
  .edition-card:focus-visible .edition-card__arrow {
    color: var(--surface-primary);
    background: var(--color-ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .edition-card__arrow {
      transition: none;
    }
  }

  @media (width <= 56.25em) {
    .edition-card {
      margin-top: var(--space-8);
    }

    .edition-card__grid {
      grid-template-columns: 1fr;
    }

    .edition-card__index {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: var(--space-1) var(--space-4);
      padding: var(--space-6);
    }

    .edition-card__numeral {
      grid-column: 2;
      grid-row: 1 / 3;
      font-size: var(--type-display);
    }

    .edition-card__session {
      grid-column: 1;
    }

    .edition-card__theme {
      padding: var(--space-8) var(--space-6) var(--space-6);
    }

    .edition-card__enter {
      gap: var(--space-4);
      margin-top: var(--space-6);
    }

    .edition-card__enter-title {
      flex-basis: 100%;
    }
  }
</style>
