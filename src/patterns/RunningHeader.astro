---
/**
 * Pattern (layout-level): persistent publication masthead framing the viewport
 * like a physical journal page (RFC-300 §2.4). Renders the name-primary brand
 * lockup (ADR-003 §3.2): the official SSPCZ logo beside a stacked wordmark —
 * the institution's name as the primary line, with the acronym + founding year
 * as a subordinate tertiary tag. The issue mark is chronological metadata drawn
 * from issue frontmatter (ADR-001 §2.1).
 */
interface Props {
  /** Primary identity line (native name in zh; the acronym in en). */
  primary: string;
  /** Subordinate tertiary tag (acronym · since-year in zh; full name in en). */
  secondary: string;
  issue: string;
  year: number | string;
  homeHref?: string;
  logoSrc?: string;
  navLabel?: string;
}

const { primary, secondary, issue, year, homeHref, logoSrc, navLabel = 'Main navigation' } = Astro.props;
const Tag = homeHref ? 'a' : 'span';
---

<header class="running-header">
  <div class="running-header__bar">
    <Tag class="running-header__brand" href={homeHref}>
      {logoSrc && <img class="running-header__logo" src={logoSrc} alt="" width="40" height="40" />}
      <span class="running-header__lockup">
        <span class="running-header__wordmark">{primary}</span>
        <span class="running-header__tag">{secondary}</span>
      </span>
    </Tag>
    <span class="running-header__issue"><span>{issue}</span><span>{year}</span></span>
  </div>
  <nav class="running-header__nav" aria-label={navLabel}>
    <slot />
  </nav>
</header>

<style>
  .running-header {
    display: contents;
  }

  /* The identity stays visible while reading; the contents line remains in
     normal flow, giving every page the same compact publication masthead. */
  .running-header__bar {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    align-items: center;
    justify-content: space-between;
    padding: var(--space-3) max(var(--page-gutter), calc((100vw - var(--page-max)) / 2 + var(--page-gutter)));
    font-family: var(--font-serif-latin);
    font-size: var(--type-marginalia);
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-muted);
    background: var(--color-paper);
    border-bottom: 1px solid var(--color-line);
  }

  /* Named with the block prefix (not `.masthead`) to avoid colliding with the
     page-level `.masthead` in global.css, whose padding + border-bottom would
     otherwise land on this header brand link. */
  .running-header__brand {
    display: inline-flex;
    flex: 1 1 min(100%, var(--brand-min));
    gap: var(--space-3);
    align-items: center;
    min-width: 0;
    min-height: var(--target-min);
    color: var(--color-ink);
  }

  /* The brand symbol ships with a transparent background (public/brand/),
     so it sits on any paper surface without blend tricks. */
  .running-header__logo {
    display: block;
    flex: 0 0 var(--space-10);
    width: var(--space-10);
    height: var(--space-10);
    object-fit: contain;
  }

  .running-header__lockup {
    display: inline-flex;
    flex-direction: column;
    min-width: 0;
    gap: var(--space-1);
    line-height: var(--leading-tight);
  }

  /* Primary line: the institution name. CJK by default; Latin under :lang(en). */
  .running-header__wordmark {
    font-family: var(--font-serif-cjk);
    font-size: var(--type-brand);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    color: var(--color-ink);
    text-wrap: balance;
  }

  :global(html:lang(en)) .running-header__wordmark {
    font-family: var(--font-serif-latin);
  }

  /* Tertiary tag: --color-text-muted (not the fainter mock grey) keeps it AA
     legible at this size while staying subordinate to the name. */
  .running-header__tag {
    font-family: var(--font-serif-latin);
    font-size: var(--type-marginalia);
    letter-spacing: var(--tracking-wider);
    color: var(--color-text-muted);
    line-height: var(--leading-normal);
    overflow-wrap: anywhere;
  }

  :global(html:lang(en)) .running-header__tag {
    letter-spacing: normal;
  }

  .running-header__issue {
    display: flex;
    flex: 0 0 auto;
    gap: var(--space-3);
    align-items: center;
    color: var(--color-text-muted);
    margin-left: auto;
    font-variant-numeric: tabular-nums;
  }

  .running-header__issue span + span {
    padding-left: var(--space-3);
    border-left: 1px solid var(--color-line-strong);
  }

  .running-header__nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-6);
    align-items: center;
    padding: var(--space-2) max(var(--page-gutter), calc((100vw - var(--page-max)) / 2 + var(--page-gutter)));
    border-bottom: 1px solid var(--color-line);
    font-family: var(--font-sans-cjk);
    font-size: var(--type-control);
    letter-spacing: normal;
  }

  :global(html:lang(en)) .running-header__nav {
    font-family: var(--font-serif-latin);
  }

  @media (width <= 56.25em) {
    .running-header__bar {
      gap: var(--space-3);
      padding: var(--space-2) var(--page-gutter-narrow);
    }

    .running-header__logo {
      flex-basis: var(--space-8);
      width: var(--space-8);
      height: var(--space-8);
    }

    .running-header__issue {
      flex-direction: column;
      gap: 0;
      align-items: flex-end;
      letter-spacing: normal;
    }

    .running-header__issue span + span {
      padding-left: 0;
      border-left: 0;
    }

    .running-header__nav {
      gap: 0 var(--space-4);
      padding: var(--space-1) var(--page-gutter-narrow) var(--space-2);
    }
  }

  @media (width <= 30em) {
    .running-header__bar {
      align-items: flex-start;
    }

    /* The full institutional name remains in the page and colophon. Keeping
       only the wordmark here preserves reading space at large text sizes. */
    .running-header__tag {
      display: none;
    }

    .running-header__issue {
      padding-top: var(--space-1);
    }
  }
</style>
